# Build output.  `build-*` covers the variant trees the feature toggles want kept side
# by side -- build-tflm for CONFIG_NN_BACKEND=tflm (issue #9), which additionally holds
# the fetched tflite-micro + CMSIS-NN source tree and is several hundred MB.
/build/
/build-*/

# RTL8720DN device firmware build (issue #20).  fw/rtl8720/build.sh exports the pinned
# upstream commit here, compiles it and drops the images -- all reproducible from the
# pins in build.sh, so none of it belongs in git.
/fw/rtl8720/out/

# Downloaded ARM GNU toolchain (fetched by cmake/arm-none-eabi-toolchain.cmake)
/tools/

# Python
__pycache__/

# Virtualenv created by cmake/tflite-micro.cmake (CONFIG_NN_BACKEND=tflm, issue #9)
# to hold numpy/Pillow for the tflite-micro tree generation.  Reproducible from
# requirements.txt, so none of it belongs in git.
/.venv/

# Reference material (schematics, datasheets, vendor SDK zips, flash backups) --
# large binaries, not source. Kept locally only.
/_ref/

# Editor swap / backup files (Vim .*.swp/.swo, emacs/gedit ~ backups)
*.sw[a-p]
*~

# RTL8720DN flash dumps that land here from a YMODEM receive (`wifi flashbackup` /
# `wifi imgsend` + `rb`, which writes to the terminal's working directory -- issue
# #19).  NEVER commit these: a full-chip image contains the factory WiFi settings
# sector at 0x105000, and the PSK in it is in the clear.  Keep them in _ref/ambd/.
/rtl8720_*.bin

# Camera frames that land here the same way (`camera send` + `rb`, issue #8).  Not
# secret like the flash dumps above, just 150 KB of nothing reproducible -- and a
# `git add -A` while verifying on hardware will sweep one in if it is not listed.
/frame*.raw

# The MLPerf Tiny runner's host virtualenv (issue #55).  Separate from /.venv above,
# which is the tflm build's: this one carries numpy/sklearn/matplotlib for the PC side
# of a benchmark run and has no business in a firmware build.
/.venv-mlperf/

# ...and the third one (issue #56), which exists only because kws01's stimulus set has
# to come out of tensorflow_datasets in tensorflow_datasets' own order.  Kept apart
# from /.venv-mlperf/ on purpose: that one installs in two minutes and is what a
# benchmark run needs, this one is a multi-gigabyte TensorFlow install nobody should
# have to make in order to run the benchmark.
/.venv-mlperf-tf/

# ...and the runner's per-run output directory, if someone starts it from the repo
# root instead of a scratch directory.  Each run writes a timestamped log plus
# results.txt/json; they are results, not sources, and one `git add -A` during a
# verification session would sweep in a directory per attempt.
/sessions/
