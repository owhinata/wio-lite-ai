+
+/* Worker task: run the handler + send the reply.  Allow-listed methods run in parallel;
+ * all others take g_serialMutex first, so state-changing handlers stay serialised. */
+__attribute__((noreturn)) static void n3_worker_task(void *arg)
+{
+    (void)arg;
+    for (;;)
+    {
+        WorkItem w;
+
+        if (xQueueReceive(g_workQueue, &w, portMAX_DELAY) != pdTRUE)
+        {
+            continue;
+        }
+        bool concurrent = n3_concurrent(w.serviceId, w.methodId);
+        if (!concurrent)
+        {
+            g_serialMutex.lock();
+        }
+        /* runInternalEnd() runs the handler, sends the reply (FramedTransport::send is
+         * lock-protected so workers cannot interleave frames) and disposes the codec. */
+        (void)g_server.processEnd(w);
+        if (!concurrent)
+        {
+            g_serialMutex.unlock();
+        }
     }
 }
 
