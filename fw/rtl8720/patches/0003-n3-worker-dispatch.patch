+        if (err != kErpcStatus_Success)
+        {
+            /* runInternalBegin() disposed any buffer/codec on every error path. */
+            continue;
+        }
+        /* Transfer ownership of the codec (and its 4 KB buffer) to a worker.  Block if the
+         * queue is full: back-pressure degrades to the stock serial rate, never a leak.
+         * portMAX_DELAY effectively never fails, but dispose defensively if it ever does. */
+        if (xQueueSend(g_workQueue, &w, portMAX_DELAY) != pdTRUE)
+        {
