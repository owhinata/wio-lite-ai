 using namespace erpc;
 
+/*============================================================================*
+ *   issue #20 N3: worker-dispatch eRPC server
+ *============================================================================*
+ * The stock server is one FreeRTOS task looping SimpleServer::poll(): receive one
+ * request, run its handler, send the reply -- strictly serial.  A handler that blocks
+ * (a socket recv with no data) therefore stalls every other RPC until it returns, which
+ * is why the host could never keep two sockets busy at once.
+ *
+ * N3 splits that loop across threads WITHOUT modifying the vendored eRPC runtime:
+ * SimpleServer already factors its work into runInternalBegin() (receive the frame +
+ * allocate buffer/codec + parse the header) and runInternalEnd() (run the handler + send
+ * the reply + dispose).  A thin subclass exposes those protected halves; a single
+ * receive task runs Begin and hands the parsed request to a small worker pool that runs
+ * End.  Concurrency correctness rests on facts already verified in the runtime:
+ *   - MessageBufferFactory::createServerBuffer() is true, so every request gets its OWN
+ *     4 KB buffer -- in-flight requests never share one.
+ *   - FramedTransport::send()/receive() each take their own lock (ERPC_THREADS=FreeRTOS),
+ *     so workers sending replies concurrently cannot interleave frames on the UART.
+ *   - malloc/free are linker-wrapped to the thread-safe RTOS heap (platform.txt
+ *     `-Wl,-wrap,malloc`), so concurrent new/delete of buffers/codecs is safe -- the same
+ *     reason the stock multi-task firmware (WiFi/BLE/lwIP) does not corrupt its heap.
+ *   - Only ONE receive task calls TransportArbitrator::receive(), so its mutex-free
+ *     pending-client scan stays single-threaded; N3 keeps the device->host callback path
+ *     (oneway rpc_wifi_event_callback, which registers no pending client) unchanged.
+ *
+ * Only the per-socket blocking receives are actually run in parallel; every state-
+ * changing handler still takes a single serial mutex (see n3_concurrent()), so it is
+ * effectively serial exactly as before and cannot race shared WiFi/lwIP state.
+ */
+
+/* Tuning.  The pinned core has INCLUDE_uxTaskGetStackHighWaterMark=0, so stack usage
+ * cannot be measured at runtime -- stacks are sized generously instead and the always-on
+ * configCHECK_FOR_STACK_OVERFLOW=2 hook traps any shortfall.  Free heap IS observable
+ * (xPortGetFreeHeapSize), and its low-water is logged to the LOG UART (`wifi log`). */
+#ifndef N3_WORKERS
+#define N3_WORKERS       2                 /* parallel handler threads (retreat to 1) */
+#endif
+#define N3_RECV_STACK    (1024 * 6)        /* receive + header parse only */
+#define N3_WORKER_STACK  (1024 * 12)       /* runs the deepest handler (was 24K, shared) */
+#define N3_QUEUE_DEPTH   (N3_WORKERS + 2)  /* parsed requests awaiting a worker */
+#ifndef N3_INSTRUMENT
+#define N3_INSTRUMENT    1                 /* log free-heap low-water while tuning */
+#endif
+
+/* A received-and-parsed request awaiting a worker.  runInternalBegin() has already
+ * received the frame, allocated its buffer + codec and read the header; the codec owns
+ * the buffer (Codec::setBuffer copies the MessageBuffer value), so this carries all the
+ * state runInternalEnd() needs to run the handler and send the reply. */
+struct WorkItem
+{
+    Codec         *codec;
+    message_type_t msgType;
+    uint32_t       serviceId;
+    uint32_t       methodId;
+    uint32_t       sequence;
+};
+
+/* Thin SimpleServer subclass exposing the protected begin/end split so the receive task
+ * and workers can run the two halves on different threads. */
+class DispatchServer : public SimpleServer
+{
+public:
+    /* Receive + parse one request into @w (buffer/codec allocated, header read).  @buff
+     * is a scratch handle; on success the codec owns the buffer, on any error path
+     * runInternalBegin() has already disposed it. */
+    erpc_status_t recvBegin(WorkItem &w, MessageBuffer &buff)
+    {
+        return runInternalBegin(&w.codec, buff, w.msgType, w.serviceId, w.methodId, w.sequence);
+    }
+    /* Run the handler for @w, send the reply if any, and dispose its buffer + codec. */
+    erpc_status_t processEnd(WorkItem &w)
+    {
+        return runInternalEnd(w.codec, w.msgType, w.serviceId, w.methodId, w.sequence);
+    }
+    /* Dispose a work item that could not be enqueued (never leak its buffer/codec). */
+    void discard(WorkItem &w) { disposeBufferAndCodec(w.codec); }
+};
+
