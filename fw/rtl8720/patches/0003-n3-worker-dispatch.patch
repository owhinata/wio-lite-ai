+/* Receive task: parse one frame at a time and hand it to a worker.  It never runs a
+ * handler, so it keeps draining the UART while workers block.  Single-threaded, so the
+ * arbitrator's mutex-free pending-client scan and its single parse codec stay safe. */
+__attribute__((noreturn)) static void n3_recv_task(void *arg)
 {
     (void)arg;
-    log_i("start erpc server\n\r");
-    /* run server */
+    log_i("[N3] erpc receive task up\n\r");
+#if N3_INSTRUMENT
+    uint32_t lo_heap = 0xffffffffu;
+#endif
     for (;;)
     {
-        g_server.poll();
