+	virtual erpc_status_t receive(MessageBuffer *message)
+	{
+		Header h;
+
+		{
+			Mutex::Guard lock(m_receiveLock);
+
+			for (;;) {
+				erpc_status_t ret = underlyingReceive((uint8_t *)&h, sizeof(h));
+				if (ret != kErpcStatus_Success) {
