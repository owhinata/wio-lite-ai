+			 * link: exact length, a magic word, an allow-list of rates, and the
+			 * sequence byte following the last CTRL frame we accepted.  None of them
+			 * is about a hostile peer -- they are about a desynchronised stream
+			 * aligning on 0xFFFF and happening to pass CRC.  The host makes the
+			 * sequence check free by sending LINK_PING immediately before this.
+			 */
+			if (plen != 8u || getU32(payload + 4) != WIO_CTRL_SETBAUD_MAGIC ||
+			    seq != (uint8_t)(m_ctrlSeq + 1u)) {
+				status = 1u;
+				break;
+			}
+			setBaud = getU32(payload);
