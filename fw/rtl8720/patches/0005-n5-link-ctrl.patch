+	/* Drop everything buffered, so a frame that made no sense cannot leave the reader
+	 * parsing the next one's header as this one's body forever. */
+	void ctrlResync(void)
+	{
+		uint8_t sink[64];
+
+		while (wio_usi_read(sink, sizeof(sink)) != 0u) {
+			;
+		}
+	}
+
+	/*
+	 * Read and act on one CTRL frame whose body length is @bodyLen.  The header
+	 * (magic + length) has already been consumed; the CRC has not.
+	 *
+	 * A desynchronised stream can align on 0xFFFF by chance, so nothing here trusts
+	 * @bodyLen before bounding it, and every command checks its own payload length.  The
+	 * one command with a real side effect additionally carries a magic word and only
+	 * accepts rates from a fixed list -- a wrong rate is not recoverable from this end.
+	 */
+	void handleCtrl(uint16_t bodyLen)
+	{
+		uint16_t crc;
+
+		/* Bound FIRST: reading a bogus length would swallow real frames. */
+		if (bodyLen > WIO_CTRL_MAX || bodyLen < WIO_CTRL_HDR) {
+			ctrlResync();
+			return;
+		}
+		if (underlyingReceive((uint8_t *)&crc, sizeof(crc)) != kErpcStatus_Success ||
+		    underlyingReceive(m_ctrlRx, bodyLen) != kErpcStatus_Success) {
+			ctrlResync();
+			return;
+		}
+		if (m_crcImpl->computeCRC16(m_ctrlRx, bodyLen) != crc) {
+			ctrlResync();
+			return;
+		}
+
+		uint8_t  cmd  = m_ctrlRx[0];
+		uint8_t  seq  = m_ctrlRx[1];
+		uint32_t plen = (uint32_t)bodyLen - WIO_CTRL_HDR;
+		const uint8_t *payload = m_ctrlRx + WIO_CTRL_HDR;
+		uint32_t rlen = 0u;
+		uint8_t  status = 0u;
+		uint32_t setBaud = 0u;
+
+		switch (cmd) {
+		case WIO_CTRL_PING:
+			/* Fixed-shape commands check their own length: a frame that reached here
+			 * by chance is unlikely to carry exactly the right one. */
+			if (plen != 0u) {
+				status = 1u;
+			}
+			break;
+
+		case WIO_CTRL_STATS: {
+			struct wio_usi_stats us;
+
+			if (plen != 0u) {
+				status = 1u;
+				break;
+			}
+			wio_usi_stats(&us);
+			putU32(m_ctrlTx + WIO_CTRL_HDR +  0, us.irqs);
+			putU32(m_ctrlTx + WIO_CTRL_HDR +  4, us.bytes);
+			putU32(m_ctrlTx + WIO_CTRL_HDR +  8, us.max_burst);
+			putU32(m_ctrlTx + WIO_CTRL_HDR + 12, us.ring_peak);
+			putU32(m_ctrlTx + WIO_CTRL_HDR + 16, us.ring_drops);
+			putU32(m_ctrlTx + WIO_CTRL_HDR + 20, us.hw_overflow);
+			putU32(m_ctrlTx + WIO_CTRL_HDR + 24, us.frame_err);
+			putU32(m_ctrlTx + WIO_CTRL_HDR + 28, (uint32_t)xPortGetFreeHeapSize());
+			putU32(m_ctrlTx + WIO_CTRL_HDR + 32, wio_usi_baud());
+			putU32(m_ctrlTx + WIO_CTRL_HDR + 36, us.ring_size);
+			putU32(m_ctrlTx + WIO_CTRL_HDR + 40, us.max_entry);
+			putU32(m_ctrlTx + WIO_CTRL_HDR + 44, us.rx_trig);
+			rlen = 48u;
+			break;
+		}
