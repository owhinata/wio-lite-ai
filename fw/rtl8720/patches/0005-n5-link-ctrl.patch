@@ -34,6 +70,49 @@ public:
 
 	virtual bool hasMessage(void) { return wio_usi_available() > 0u; }
 
+	/*
+	 * Same contract as FramedTransport::receive() -- return exactly one eRPC message --
+	 * but loop over CTRL frames instead of returning after one.  Consuming a CTRL frame
+	 * is not an event the eRPC server knows how to be told about, so it must not be
+	 * allowed to surface as a short read or a spurious return.
