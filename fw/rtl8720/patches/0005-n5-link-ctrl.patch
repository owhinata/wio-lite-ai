+			    setBaud != 4000000u && setBaud != 6000000u) {
+				status = 1u;
+				setBaud = 0u;
+			}
+			break;
+
+		case WIO_CTRL_BENCH: {
+			uint32_t want;
+
+			if (plen < 8u) {
+				status = 1u;
+				break;
+			}
+			want = getU32(payload);
+			if (want > WIO_CTRL_MAX - WIO_CTRL_HDR - 4u) {
+				status = 1u;
+				break;
+			}
+			/* Echo how many payload bytes actually arrived: the host compares it
+			 * with what it sent, which is the direct test for the lost-tail failure
+			 * the stock Arduino ring used to cause. */
+			putU32(m_ctrlTx + WIO_CTRL_HDR, plen - 8u);
+			fillPattern(m_ctrlTx + WIO_CTRL_HDR + 4u, want, payload[4]);
+			rlen = 4u + want;
+			break;
+		}
+
+		default:
+			status = 1u;
+			break;
+		}
+
+		sendCtrl(cmd, seq, status, rlen);
+
+		/* AFTER the acknowledgement is on the wire -- it necessarily goes out at the
+		 * old rate, and the host is waiting for it before it switches its own end. */
+		if (setBaud != 0u) {
+			wio_usi_set_baud(setBaud);
+		}
+		m_ctrlSeq = seq;
+	}
+
+	/* Frame and write the reply held in m_ctrlTx (payload length @rlen). */
+	void sendCtrl(uint8_t cmd, uint8_t seq, uint8_t status, uint32_t rlen)
+	{
+		uint16_t bodyLen = (uint16_t)(WIO_CTRL_HDR + rlen);
+		uint8_t hdr[6];
+
+		m_ctrlTx[0] = cmd;
+		m_ctrlTx[1] = seq;
+		m_ctrlTx[2] = status;
+		m_ctrlTx[3] = 0u;
+
+		hdr[0] = (uint8_t)WIO_CTRL_MAGIC;
+		hdr[1] = (uint8_t)(WIO_CTRL_MAGIC >> 8);
+		hdr[2] = (uint8_t)bodyLen;
+		hdr[3] = (uint8_t)(bodyLen >> 8);
+
+		uint16_t crc = m_crcImpl->computeCRC16(m_ctrlTx, bodyLen);
+		hdr[4] = (uint8_t)crc;
+		hdr[5] = (uint8_t)(crc >> 8);
+
+		/* The worker tasks send eRPC replies concurrently; without this their bytes
+		 * and ours would interleave inside a frame. */
+		Mutex::Guard lock(m_sendLock);
+		wio_usi_write(hdr, sizeof(hdr));
+		wio_usi_write(m_ctrlTx, bodyLen);
+	}
+
+	static void putU32(uint8_t *p, uint32_t v)
+	{
+		p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8);
+		p[2] = (uint8_t)(v >> 16); p[3] = (uint8_t)(v >> 24);
+	}
+
+	static uint32_t getU32(const uint8_t *p)
+	{
+		return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+		       ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+	}
+
+	/* Same generator as the host's, so both ends make identical bytes from a seed.  Its
+	 * job is only to put real transitions on the line; integrity is the frame CRC's. */
+	static void fillPattern(uint8_t *buf, uint32_t n, uint8_t seed)
+	{
+		uint32_t x = 0x12345678u ^ (uint32_t)seed;
+
+		for (uint32_t i = 0u; i < n; i++) {
+			x = x * 1103515245u + 12345u;
+			buf[i] = (uint8_t)(x >> 24);
+		}
+	}
+
 	uint32_t m_baudrate;
+	uint8_t  m_ctrlSeq;                  /* last CTRL sequence acted on (diagnostic) */
+	uint8_t  m_ctrlRx[WIO_CTRL_MAX];
+	uint8_t  m_ctrlTx[WIO_CTRL_MAX];
 };
 
 } /* namespace erpc */
