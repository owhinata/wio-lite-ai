 	uint32_t hw_overflow;   /* RX FIFO overrun interrupts: hardware loss, must stay 0 */
 	uint32_t frame_err;     /* stop-bit (framing) errors: marginal baud rate */
+	uint32_t ring_size;     /* ring capacity, so ring_peak can be read as a fraction */
+	uint32_t max_entry;     /* high-water FIFO occupancy AT INTERRUPT ENTRY -- the real
+	                         * measure of consumed grace.  Overrun happens at 64, so the
+	                         * budget is (64 - rx_trig) and this says how much was used;
+	                         * max_burst above cannot answer that, because it also counts
+	                         * bytes that arrived during the drain (which are free) */
+	uint32_t rx_trig;       /* the configured threshold, so a reader can compute the
+	                         * budget without knowing this driver's constants */
