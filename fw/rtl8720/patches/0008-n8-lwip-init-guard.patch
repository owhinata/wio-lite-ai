diff --git a/src/erpc_setup.cpp b/src/erpc_setup.cpp
index c7e5856..1326402 100644
--- a/src/erpc_setup.cpp
+++ b/src/erpc_setup.cpp
@@ -184,16 +184,16 @@ char * rpc_system_version(void)
      * literal and freeing that .rodata pointer corrupts the module heap (which is why
      * the STM32 side never dared call rpc_system_version).  Return an erpc_malloc copy
      * of a build id so the host can read back which firmware is loaded (`wifi rpc`).
-     * "2.1.3" keeps the upstream base version; "+wio-n7" marks the issue-#20 N3 patch
+     * "2.1.3" keeps the upstream base version; "+wio-n8" marks the issue-#20 N3 patch
      * set (bounded socket handlers + worker dispatch) plus the issue-#23 link work:
      * U0-2's USI0 driver, U0-3's LINK-CTRL channel, U1's DATA channel and U2's L2
-     * bridge.  The host PARSES the N out of
+     * bridge, and issue #31's LwIP_Init entry guard.  The host PARSES the N out of
      * this string (shell/cmds/cmd_wifi.c fw_gen_of) and gates capabilities on it being
      * large enough, so the number must only ever go up.  A NULL here would only happen
      * on heap exhaustion,
      * which the stock literal never risked; the shim does not null-check, but version is
      * called early when the heap is idle. */
-    static const char id[] = "2.1.3+wio-n7";
+    static const char id[] = "2.1.3+wio-n8";
     char *s = (char *)erpc_malloc(sizeof(id));
     if (s != NULL)
         memcpy(s, id, sizeof(id));
diff --git a/src/wifi/wifi_tcpip_adapter.c b/src/wifi/wifi_tcpip_adapter.c
index 4b2d332..6063a38 100644
--- a/src/wifi/wifi_tcpip_adapter.c
+++ b/src/wifi/wifi_tcpip_adapter.c
@@ -41,8 +41,45 @@
 
 extern struct netif xnetif[NET_IF_NUM];
 
+/*
+ * ISSUE #31 (#30 B0): LwIP_Init() has no entry guard of its own.
+ *
+ * It sets `lwip_init_done = 1` at its END and never looks at it on entry, so a SECOND
+ * rpc_tcpip_adapter_init would run the whole thing again:
+ *   - tcpip_init() -> a second tcpip thread, and
+ *   - netif_add(&xnetif[0], ..., ethernetif_init, &tcpip_input)
+ *     -> xnetif[0].input is put back to tcpip_input, which SILENTLY UNHOOKS the L2
+ *        bridge tap wio_link_eth.c installed there (patch 0007).
+ *
+ * Since issue #30 made that bridge permanent, the tap is the host's only path to the
+ * network, so the failure mode is "the network disappears, with nothing logged on either
+ * side".  Up to now the only thing preventing it was a latch on the HOST
+ * (rtl_tcpip_inited in app/rtl_link.c) -- one flag, on the wrong side of the wire: it
+ * cannot cover a host that restarts its own state, a second console, or a retry after a
+ * timeout whose reply merely came late.  The guard belongs here, where the state lives.
+ * The host latch stays as well; two independent guards is the point.
+ *
+ * WHY `lwip_init_done` AND NOT A PRIVATE FLAG OF OUR OWN: it is the real state.
+ * LwIP_Init sets it itself, so it also reads 1 when something inside the SDK brought
+ * lwIP up without coming through here -- a private flag would be 0 in exactly that case
+ * and would let the double init through.  It is not declared in lwip_netconf.h, but it
+ * is a plain global in the prebuilt library and .bss-zeroed, so a fresh boot still runs
+ * the init:
+ *
+ *   $ arm-none-eabi-nm --print-size lib_arduino.a   (lwip_netconf.o)
+ *   00000000 00000004 B lwip_init_done
+ *
+ * 4 bytes = int, GLOBAL (B, not b), which is what this declaration has to agree with.
+ */
+extern int lwip_init_done;
+
 void tcpip_adapter_init(void)
 {
+    if (lwip_init_done)
+    {
+        /* Already up.  Re-running LwIP_Init here would unhook the bridge tap. */
+        return;
+    }
     LwIP_Init();
 }
 
