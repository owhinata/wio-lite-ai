diff --git a/src/link/wio_link_eth.c b/src/link/wio_link_eth.c
new file mode 100644
index 0000000..4502700
--- /dev/null
+++ b/src/link/wio_link_eth.c
@@ -0,0 +1,410 @@
+/*
+ * wio_link_eth -- the L2 bridge (issue #23 U2).  See wio_link_eth.h for why the tap is a
+ * swap of xnetif[0].input, why the netif address has to be zeroed, and why both of those
+ * happen on the tcpip thread.
+ *
+ * THREADS.  Four of them touch this file and they are all different:
+ *   - the WiFi driver's receive thread runs wio_l2_input()   (frames from the air)
+ *   - the DATA receive task runs wio_eth_to_air()            (frames from the host)
+ *   - the eRPC receive task runs wio_eth_bridge()/wio_eth_info() (LINK-CTRL)
+ *   - the DATA transmit task runs wio_eth_tick()             (the watchdog)
+ * The tcpip thread runs the one callback that actually mutates the netif.
+ *
+ * The counters are plain u32 incremented from two of those threads, so they are guarded by
+ * the shortest critical section FreeRTOS has.  They are diagnostics, but a diagnostic that
+ * silently loses counts is how U1's "is this a link failure or an Ethernet drop?" question
+ * became hard to answer, and the answer here has to stay trustworthy.
+ */
+
+#include "FreeRTOS.h"
+#include "task.h"
+#include "semphr.h"
+
+#include "lwip/opt.h"
+#include "lwip/err.h"
+#include "lwip/pbuf.h"
+#include "lwip/netif.h"
+#include "lwip/ip_addr.h"
+#include "lwip/tcpip.h"
+#include "ethernetif.h"
+#include "lwip_intf.h"
+#include "lwip_netconf.h"
+
+#include "wio_link_data.h"
+#include "wio_link_eth.h"
+
+#include <string.h>
+
+/*
+ * xnetif is a COMMON symbol in the prebuilt lib_arduino.a:lwip_netconf.o, 128 bytes, and
+ * index 0 is the station interface.  If this build's idea of struct netif does not match
+ * the one the prebuilt libraries were compiled against, every field offset touched here is
+ * wrong -- so make that a build failure rather than something to discover on the only
+ * surviving board.  (readelf on lwip_netconf.o: "128 OBJECT GLOBAL DEFAULT COM xnetif";
+ * autoconf.h defines CONFIG_CONCURRENT_MODE, hence NET_IF_NUM == 2.)
+ */
+extern struct netif xnetif[NET_IF_NUM];
+_Static_assert(NET_IF_NUM * sizeof(struct netif) == 128,
+               "struct netif does not match the prebuilt xnetif -- do not flash this");
+
+/* Set by LwIP_Init(), which the host triggers with rpc_tcpip_adapter_init during
+ * `wifi connect`.  Until then there is no tcpip thread to post a callback to. */
+extern int lwip_init_done;
+
+#define WIO_ETH_IF        0                      /* station interface */
+#define WIO_ETH_APPLY_TMO 500u                   /* ms to wait for the tcpip thread */
+#define WIO_ETH_GRACE_MS  50u                    /* ...and for one already in progress */
+
+/*
+ * Publish the state before the pointer that makes another thread act on it.  The WLAN
+ * receive thread is not serialised against the tcpip callback, so this ordering is what
+ * makes the stale-pointer window a counted drop instead of a use of half-updated state.
+ * Inline asm rather than CMSIS so this file needs no SoC header.
+ */
+#define WIO_ETH_PUBLISH() __asm volatile ("dmb 0xF" ::: "memory")
+
+static SemaphoreHandle_t e_lock;                 /* serialises wio_eth_bridge() */
+static SemaphoreHandle_t e_done;                 /* the tcpip callback has finished */
+
+static volatile uint8_t  e_bridged;
+static netif_input_fn    e_saved_input;
+static ip4_addr_t        e_saved_ip, e_saved_mask, e_saved_gw;
+
+static volatile uint32_t e_deadline;             /* tick count when the bridge times out */
+static volatile uint8_t  e_armed;
+
+/*
+ * Request identity.  @e_req_seq names the only request the tcpip callback is allowed to
+ * act on; bumping it ABANDONS whatever is still pending.  @e_done_seq says which request a
+ * completion token belongs to.  Both are written under e_lock (or by the callback, which
+ * exactly one request owns at a time) and read by the tcpip thread.
+ */
+static volatile uint32_t e_req_seq, e_done_seq;
+static volatile uint8_t  e_req_on;
+
+static uint32_t st_rx_frames, st_rx_bytes, st_rx_nobuf, st_rx_oversize;
+static uint32_t st_tx_frames, st_tx_bytes, st_tx_fail, st_tx_down;
+
+static void e_bump(uint32_t *ctr, uint32_t by)
+{
+	taskENTER_CRITICAL();
+	*ctr += by;
+	taskEXIT_CRITICAL();
+}
+
+/* ------------------------------------------------------------------ *
+ *  air -> host
+ * ------------------------------------------------------------------ */
+/*
+ * The tap.  Runs on the WiFi driver's receive thread.
+ *
+ * OWNERSHIP: ethernetif_recv() frees the pbuf only when input returns something other than
+ * ERR_OK, so this function owns @p -- copy it out, free it, return ERR_OK.  It must never
+ * hand the frame on to the saved input as well: a frame belongs to exactly one stack.
+ */
+static err_t wio_l2_input(struct pbuf *p, struct netif *nif)
+{
+	uint8_t *dst;
+	int idx;
+	u16_t n;
+
+	(void)nif;
+	if (p == NULL)
+		return ERR_OK;
+	n = p->tot_len;
+
+	if (!e_bridged) {
+		/* The pointer swap is not serialised against this thread, so one more frame
+		 * can still arrive through the old pointer after the bridge went down.  Own
+		 * it and drop it -- delivering it into a stack that is mid-teardown is the
+		 * one thing worse than losing it. */
+		e_bump(&st_rx_nobuf, 1u);
+		pbuf_free(p);
+		return ERR_OK;
+	}
+	if (n == 0u || n > WIO_DATA_PAYLOAD_MAX) {
+		e_bump(&st_rx_oversize, 1u);
+		pbuf_free(p);
+		return ERR_OK;
+	}
+
+	/* Straight from the pbuf chain into the pool buffer: no staging buffer anywhere, and
+	 * the slot is held outside the DATA lock only for this copy. */
+	dst = wio_link_data_tx_claim(&idx);
+	if (dst == NULL) {
+		e_bump(&st_rx_nobuf, 1u);        /* pool full or transmission disabled */
+		pbuf_free(p);
+		return ERR_OK;
+	}
+	if (pbuf_copy_partial(p, dst, n, 0) != n) {
+		wio_link_data_tx_drop(idx);
+		e_bump(&st_rx_oversize, 1u);
+		pbuf_free(p);
+		return ERR_OK;
+	}
+	pbuf_free(p);
+
+	if (wio_link_data_tx_commit(idx, WIO_DATA_CHAN_ETH, (uint16_t)n) == 0) {
+		taskENTER_CRITICAL();
+		st_rx_frames++;
+		st_rx_bytes += n;
+		taskEXIT_CRITICAL();
+	} else {
+		/* Refused: a CFG(OFF) landed while the copy was running.  That refusal is
+		 * exactly what keeps the acknowledgement the host already has honest. */
+		e_bump(&st_rx_nobuf, 1u);
+	}
+	return ERR_OK;
+}
+
+/* ------------------------------------------------------------------ *
+ *  host -> air
+ * ------------------------------------------------------------------ */
+void wio_eth_to_air(const uint8_t *p, uint16_t n)
+{
+	struct eth_drv_sg sg;
+
+	/* 14 = destination + source + ethertype.  Anything shorter is not a frame. */
+	if (p == NULL || n < 14u || n > WIO_DATA_PAYLOAD_MAX) {
+		e_bump(&st_tx_fail, 1u);
+		return;
+	}
+	if (!e_bridged || !rltk_wlan_running(WIO_ETH_IF)) {
+		e_bump(&st_tx_down, 1u);
+		return;
+	}
+
+	/* One scatter entry pointing at the DATA pool buffer is byte-for-byte what
+	 * low_level_output() would have built from a single-pbuf chain; rltk_wlan_send()
+	 * copies it into an skb, so the buffer is free again the moment it returns.  The
+	 * cast drops const: the driver only reads through this pointer. */
+	sg.buf = (unsigned int)(uintptr_t)p;
+	sg.len = n;
+	if (rltk_wlan_send(WIO_ETH_IF, &sg, 1, (int)n) == 0) {
+		taskENTER_CRITICAL();
+		st_tx_frames++;
+		st_tx_bytes += n;
+		taskEXIT_CRITICAL();
+	} else {
+		e_bump(&st_tx_fail, 1u);
+	}
+}
+
+/* ------------------------------------------------------------------ *
+ *  installing and removing the tap
+ * ------------------------------------------------------------------ */
+/*
+ * Runs ON THE TCPIP THREAD, which is the whole reason this is a callback: lwIP here is
+ * NO_SYS=0 with LWIP_TCPIP_CORE_LOCKING=0, so netif_set_addr() from an arbitrary task
+ * would race the stack's own use of the netif.
+ *
+ * ORDER, both directions:
+ *   on   save state -> zero the address -> publish e_bridged -> swap in the tap
+ *        (the address goes first: with a stale address the driver would filter unicast IP
+ *         before it ever reached us, so the tap must not be live before it is zeroed)
+ *   off  clear e_bridged -> restore the input -> restore the address
+ *        (e_bridged goes first: a frame arriving through the not-yet-restored pointer is
+ *         then dropped by the tap rather than delivered into a half-restored stack)
+ *
+ * @ctx is the REQUEST SEQUENCE, not a boolean, and the check against e_req_seq is what
+ * makes a bounded wait safe.  tcpip_callback_with_block() only blocks until the message is
+ * posted, so a requester that gives up would otherwise leave a callback able to mutate the
+ * netif minutes later, with nothing to say which completion belonged to whom.  Abandoning
+ * a request bumps e_req_seq, and a callback that finds it moved on changes NOTHING and
+ * signals NOBODY.
+ */
+static void wio_eth_apply(void *ctx)
+{
+	struct netif *nif = &xnetif[WIO_ETH_IF];
+	uint32_t seq = (uint32_t)(uintptr_t)ctx;
+	uint8_t on;
+	ip4_addr_t zero;
+
+	if (seq != e_req_seq)
+		return;                          /* abandoned before we started */
+	on = e_req_on;
+
+	if (on && !e_bridged) {
+		e_saved_input = nif->input;
+		ip4_addr_copy(e_saved_ip,   *ip_2_ip4(&nif->ip_addr));
+		ip4_addr_copy(e_saved_mask, *ip_2_ip4(&nif->netmask));
+		ip4_addr_copy(e_saved_gw,   *ip_2_ip4(&nif->gw));
+
+		ip4_addr_set_zero(&zero);
+		netif_set_addr(nif, &zero, &zero, &zero);
+
+		e_bridged = 1u;
+		WIO_ETH_PUBLISH();
+		nif->input = wio_l2_input;
+	} else if (!on && e_bridged) {
+		e_bridged = 0u;
+		WIO_ETH_PUBLISH();
+		nif->input = e_saved_input;
+		netif_set_addr(nif, &e_saved_ip, &e_saved_mask, &e_saved_gw);
+	}
+	e_done_seq = seq;                        /* whose completion this is */
+	WIO_ETH_PUBLISH();
+	xSemaphoreGive(e_done);
+}
+
+/*
+ * Wait for the completion of request @seq specifically.  A token from an ABANDONED earlier
+ * request (one that slipped past its sequence check just as it was given up on) is
+ * discarded rather than mistaken for ours -- which is the other half of why a bounded wait
+ * is safe here.
+ */
+static int e_wait_apply(uint32_t seq, uint32_t ms)
+{
+	TickType_t end = xTaskGetTickCount() + pdMS_TO_TICKS(ms);
+
+	for (;;) {
+		int32_t left = (int32_t)(end - xTaskGetTickCount());
+
+		if (left < 0)
+			left = 0;
+		if (xSemaphoreTake(e_done, (TickType_t)left) != pdTRUE)
+			return -1;
+		if (e_done_seq == seq)
+			return 0;
+	}
+}
+
+/* The body of wio_eth_bridge(), with e_lock already held. */
+static uint8_t e_bridge_locked(uint8_t on, uint32_t hold_ms)
+{
+	uint32_t seq;
+	uint8_t rc = 0u;
+
+	if (on) {
+		if (!lwip_init_done) {
+			/* No tcpip thread yet: the host has not run `wifi connect`, so
+			 * rpc_tcpip_adapter_init has not happened. */
+			return 3u;
+		}
+		if (hold_ms == 0u || hold_ms > WIO_ETH_HOLD_MAX_MS)
+			hold_ms = WIO_ETH_HOLD_DEF_MS;
+		/* Armed BEFORE anything can install the tap, and deliberately left armed if the
+		 * request below fails: if the tap did go in after all, the watchdog is what
+		 * takes it out again. */
+		e_deadline = xTaskGetTickCount() + pdMS_TO_TICKS(hold_ms);
+		e_armed    = 1u;
+		if (e_bridged)
+			return 0u;               /* already up: only the deadline moved */
+		taskENTER_CRITICAL();
+		st_rx_frames = st_rx_bytes = st_rx_nobuf = st_rx_oversize = 0u;
+		st_tx_frames = st_tx_bytes = st_tx_fail  = st_tx_down     = 0u;
+		taskEXIT_CRITICAL();
+	} else {
+		if (!e_bridged) {
+			e_armed = 0u;
+			return 0u;
+		}
+	}
+
+	seq = ++e_req_seq;                       /* also abandons anything still pending */
+	e_req_on = on;
+	WIO_ETH_PUBLISH();
+	if (tcpip_callback_with_block(wio_eth_apply, (void *)(uintptr_t)seq, 1) != ERR_OK)
+		return 4u;
+
+	if (e_wait_apply(seq, WIO_ETH_APPLY_TMO) == 0) {
+		if (!on)
+			e_armed = 0u;            /* down for good: stop the watchdog retrying */
+		return 0u;
+	}
+
+	/*
+	 * Timed out.  Abandon the request: a callback that has not reached its sequence check
+	 * yet will now do nothing at all.  One already PAST that check is finishing right now
+	 * -- it is a handful of field writes on the tcpip thread -- so allow a short grace
+	 * before concluding that nothing changed, rather than reporting a failure that has
+	 * already taken effect.
+	 */
+	e_req_seq++;
+	if (e_wait_apply(seq, WIO_ETH_GRACE_MS) == 0) {
+		if (!on)
+			e_armed = 0u;
+		return 0u;
+	}
+	rc = 5u;
+	if (!on) {
+		/* The tap may still be in.  Leave the watchdog armed and already expired so
+		 * the DATA transmit task keeps retrying until it succeeds -- the alternative
+		 * is a module left bridged with nothing left to notice. */
+		e_deadline = xTaskGetTickCount();
+		e_armed    = 1u;
+	}
+	return rc;
+}
+
+uint8_t wio_eth_bridge(uint8_t on, uint32_t hold_ms)
+{
+	uint8_t rc;
+
+	if (e_lock == NULL || e_done == NULL)
+		return 2u;                       /* wio_eth_init() never ran */
+	xSemaphoreTake(e_lock, portMAX_DELAY);
+	rc = e_bridge_locked(on, hold_ms);
+	xSemaphoreGive(e_lock);
+	return rc;
+}
+
+int wio_eth_tick(void)
+{
+	uint8_t rc;
+
+	if (!e_armed || !e_bridged)
+		return 0;
+	if ((int32_t)(xTaskGetTickCount() - e_deadline) < 0)
+		return 0;
+	/*
+	 * The host is gone or stopped asking.  Take the tap down -- but NEVER block here on
+	 * the mutex: this runs on the DATA transmit task, and a CFG in progress on the eRPC
+	 * receive task can hold it for the tcpip timeout.  Missing a turn costs 20 ms.
+	 */
+	if (e_lock == NULL || xSemaphoreTake(e_lock, 0) != pdTRUE)
+		return 0;
+	rc = e_bridge_locked(0u, 0u);
+	xSemaphoreGive(e_lock);
+	/* Only report success: on failure the watchdog stays armed and expired, so this is
+	 * retried on the next pass rather than the mode being cleared under a live tap. */
+	return (rc == 0u) ? 1 : 0;
+}
+
+/* ------------------------------------------------------------------ *
+ *  reporting / init
+ * ------------------------------------------------------------------ */
+void wio_eth_info(uint8_t mac[6], uint8_t *flags, uint32_t st[WIO_ETH_STAT_WORDS])
+{
+	const unsigned char *hw = netif_get_hwaddr(WIO_ETH_IF);
+
+	if (mac != NULL) {
+		if (hw != NULL)
+			memcpy(mac, hw, 6);
+		else
+			memset(mac, 0, 6);
+	}
+	if (flags != NULL)
+		*flags = (uint8_t)((e_bridged ? WIO_ETH_F_BRIDGED : 0u) |
+		                   (rltk_wlan_running(WIO_ETH_IF) ? WIO_ETH_F_RUNNING : 0u));
+	if (st == NULL)
+		return;
+	taskENTER_CRITICAL();
+	st[0] = st_rx_frames;
+	st[1] = st_rx_bytes;
+	st[2] = st_rx_nobuf;
+	st[3] = st_rx_oversize;
+	st[4] = st_tx_frames;
+	st[5] = st_tx_bytes;
+	st[6] = st_tx_fail;
+	st[7] = st_tx_down;
+	taskEXIT_CRITICAL();
+}
+
+void wio_eth_init(void)
+{
+	if (e_lock != NULL)
+		return;
+	e_done = xSemaphoreCreateBinary();
+	e_lock = xSemaphoreCreateMutex();        /* last: it is what the others gate on */
+}
diff --git a/src/link/wio_link_eth.h b/src/link/wio_link_eth.h
new file mode 100644
index 0000000..5fe81bb
--- /dev/null
+++ b/src/link/wio_link_eth.h
@@ -0,0 +1,113 @@
+/*
+ * wio_link_eth -- the L2 bridge (issue #23 U2, wio-lite-ai).
+ *
+ * Turns this firmware from a socket-offload server into a relay of RAW ETHERNET FRAMES, so
+ * the STM32 can run its own TCP/IP stack (issue #23 road B).  Frames received from the air
+ * leave over the link's DATA channel on WIO_DATA_CHAN_ETH; frames arriving on that channel
+ * go out over the air.  Nothing here parses IP -- that is the whole point.
+ *
+ * ---- how the tap works -------------------------------------------------------
+ *
+ * The receive chain inside the SDK is fixed and indexes a global array in the PREBUILT
+ * libraries, so it cannot be redirected by adding a netif of our own:
+ *
+ *   lib_wlan.a:rtk_wlan_if.o -> netif_rx(idx, len)             (lib_arduino.a:lwip_intf.o)
+ *                            -> ethernetif_recv(&xnetif[idx])  (lib_arduino.a:ethernetif.o)
+ *                            -> netif->input(pbuf, netif)      <-- the one hookable point
+ *
+ * So LwIP_Init() runs exactly as before (the host still calls rpc_tcpip_adapter_init) and
+ * the bridge simply SWAPS xnetif[0].input.  That also makes the bypass reversible: switch
+ * it off and the module's own lwIP is intact, which is what keeps `net ping`, `net echo`
+ * and the telnet console working as the regression test for everything else.
+ *
+ * ---- two things that are not obvious ------------------------------------------
+ *
+ * 1. THE WLAN DRIVER FILTERS RECEIVED IP PACKETS AGAINST THE NETIF'S ADDRESS.
+ *    netif_is_valid_IP() is an undefined reference in lib_wlan.a:rtk_wlan_if.o and
+ *    ethernet_rswlan.o, and it returns 1 unconditionally only when the netif's IPv4
+ *    address is 0.  A bridge session therefore has to ZERO xnetif[0]'s address (and put it
+ *    back afterwards), or unicast IP addressed to whatever the host's stack calls itself
+ *    is dropped before it ever reaches netif_rx().  ARP is not IP and is unaffected, which
+ *    is exactly why "ARP is visible" is a weaker test than "the bridge works".
+ *
+ * 2. lwIP here is NO_SYS=0 with LWIP_TCPIP_CORE_LOCKING=0, so a netif may not be mutated
+ *    from an arbitrary task.  Both the address change and the input swap are therefore
+ *    performed ON THE TCPIP THREAD through tcpip_callback_with_block(), which only blocks
+ *    until the message is POSTED -- so the callback signals a semaphore and the caller
+ *    waits for that, bounded, and reports a failure rather than assuming one.
+ *    The host additionally stops the DHCP client (over the existing eRPC path) before
+ *    asking for the bridge, because that is what the adapter's own header requires before
+ *    IP information is changed.
+ */
+#ifndef WIO_LINK_ETH_H
+#define WIO_LINK_ETH_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Counters, in the order wio_eth_info() writes them. */
+#define WIO_ETH_STAT_WORDS  8u
+
+/* Default and maximum watchdog window for a bridge session, in milliseconds. */
+#define WIO_ETH_HOLD_DEF_MS 10000u
+#define WIO_ETH_HOLD_MAX_MS 60000u
+
+/* Create the lock and the completion semaphore.  Call once from setup_erpc(); every other
+ * entry point here is inert until it has run, so a failure to allocate leaves the bridge
+ * unavailable rather than unsafe. */
+void wio_eth_init(void);
+
+/* wio_eth_info() flags. */
+#define WIO_ETH_F_BRIDGED   0x01u
+#define WIO_ETH_F_RUNNING   0x02u        /* rltk_wlan_running(0): the radio is up */
+
+/*
+ * Install (@on != 0) or remove the tap.  @hold_ms arms a watchdog: the bridge takes itself
+ * down that many milliseconds later, so a host that dies mid-session cannot leave the
+ * module forwarding into a link nobody reads while its own lwIP starves.  0 means "no
+ * deadline" and is only used by the OFF path.
+ *
+ * Returns a CTRL status byte: 0 accepted, non-zero refused -- 2 not initialised, 3 no
+ * tcpip thread yet (the host has not run `wifi connect`), 4 the callback could not be
+ * posted, 5 the tcpip thread did not answer within the bound.  Idempotent: turning it on
+ * twice only re-arms the deadline.
+ *
+ * What a non-zero return guarantees is NOT "nothing changed" -- it is that no change can be
+ * left standing with nobody to undo it.  tcpip_callback_with_block() blocks only until the
+ * message is posted, so every request carries a sequence number: giving up bumps it, and a
+ * callback that finds it moved on changes nothing and signals nobody.  One already past
+ * that check is finishing as we give up, so a short grace period catches its completion and
+ * the call succeeds after all.  What remains is a callback that lands later still, and the
+ * watchdog is what covers it: it is armed BEFORE the request that could install the tap and
+ * is left armed when that request fails, and a failed OFF re-arms it already expired so the
+ * DATA transmit task keeps retrying.  So the residual states are transient, not stuck.
+ *
+ * Called from the eRPC receive task (via wio_link_data_cfg) and from the DATA transmit
+ * task (via wio_eth_tick).  It BLOCKS on the tcpip thread, so it must not be called with
+ * the DATA channel's lock held.
+ */
+uint8_t wio_eth_bridge(uint8_t on, uint32_t hold_ms);
+
+/* Put one frame from the host on the air.  A no-op (counted) when the bridge is off or the
+ * radio is down.  Called from the DATA receive task with no lock held. */
+void wio_eth_to_air(const uint8_t *p, uint16_t n);
+
+/* LINK_ETH_INFO: the MAC the host must use as its source address, flags, and counters. */
+void wio_eth_info(uint8_t mac[6], uint8_t *flags, uint32_t st[WIO_ETH_STAT_WORDS]);
+
+/*
+ * Take the bridge down if its deadline has passed.  Cheap when idle; called once per loop
+ * of the DATA transmit task, OUTSIDE its locked step (this can block on the tcpip thread).
+ * Returns 1 when it just took the bridge down, so the caller -- which owns the DATA
+ * channel's mode -- can finish the shutdown; returns 0 otherwise.
+ */
+int wio_eth_tick(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* WIO_LINK_ETH_H */
